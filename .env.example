# Runtime
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Local OIDC bypass is for development only and must remain false in production.
DEV_AUTH_ENABLED=true
DEV_USER_ID=local-user
DEV_TENANT_ID=local-tenant
DEV_ROLES=agent:user,agent:approver,agent:admin
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# Durable harness state (external managed services in production)
POSTGRES_DSN=postgresql://user:password@postgres.example:5432/data_chat_agent
POSTGRES_MIGRATION_DSN=postgresql://migration_user:password@postgres.example:5432/data_chat_agent
POSTGRES_POOL_MAX_SIZE=20
REDIS_URL=rediss://user:password@redis.example:6379/0
REDIS_POOL_MAX_CONNECTIONS=100

# Existing data services
MYSQL_ROOT_PASSWORD=change-me-for-local-only
MYSQL_USER=didilili
MYSQL_PASSWORD=change-me-for-local-only
META_DB_HOST=127.0.0.1
META_DB_PASSWORD=change-me-for-local-only
META_DB_POOL_SIZE=20
DW_DB_HOST=127.0.0.1
DW_DB_PASSWORD=change-me-for-local-only
DW_DB_POOL_SIZE=20
QDRANT_HOST=127.0.0.1
EMBEDDING_HOST=127.0.0.1
ES_HOST=127.0.0.1

# LLM
LLM_MODEL_NAME=Pro/zai-org/GLM-5.1
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=

# OpenTelemetry / Langfuse
OTEL_ENABLED=true
OTEL_EXPORTER_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=data-chat-agent
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_CAPTURE_CONTENT=false

# Collector upstream (used by docker/otel-collector-config.yaml)
OTEL_UPSTREAM_ENDPOINT=
OTEL_UPSTREAM_AUTH_HEADER=
